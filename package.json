{
  "name": "wedding-planner",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @wedding/api",
    "dev:web": "npm run dev -w @wedding/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test -w @wedding/api && npm run test:runtime -w @wedding/api",
    "test:watch": "npm run test:watch -w @wedding/api"
  }
}
