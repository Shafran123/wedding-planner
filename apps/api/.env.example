# Wedding Planner API
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/wedding-planner
CORS_ORIGIN=http://localhost:3000

# Firebase service account (server-side only — never ship this file)
# Generate one in Firebase console → Project settings → Service accounts.
# Either set the path to the JSON key file, or paste the JSON inline.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
